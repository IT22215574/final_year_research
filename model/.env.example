# Copy this file to `.env` and fill with your real credentials.
# WARNING: Do NOT commit `.env` to version control. Add it to .gitignore.

# Required: Copernicus account credentials
# Example: COPERNICUS_USER=your.email@example.com
COPERNICUS_USER=your_username_here
# Example: COPERNICUS_PASS=My$ecureP@ssw0rd
COPERNICUS_PASS=your_password_here

# Optional overrides (leave commented to use defaults in the script)
# BASE_DATA_FOLDER="Fish zone daily data"
# KEEP_ONLY_LATEST=true
# MAX_RETRY_DAYS=5

# If you need to set proxy or python path, add them here as needed
# HTTP_PROXY=
# HTTPS_PROXY=
