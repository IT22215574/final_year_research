# ====================================
# Backend API Configuration
# ====================================

# Main Backend API (NestJS - port 5006)
# Used for: Fish zones, trips, boats, user management, etc.
# iOS Simulator: http://localhost:5006
# Android Emulator: http://10.0.2.2:5006
# Physical Device: http://YOUR_LOCAL_IP:5006 (e.g., http://192.168.1.100:5006)
EXPO_PUBLIC_API_URL=http://localhost:5006

# Fish Quality Grading API (FastAPI - port 8000)
# Used for: Fish species detection, quality grading, image analysis
# iOS Simulator: http://localhost:8000
# Android Emulator: http://10.0.2.2:8000
# Physical Device: http://YOUR_LOCAL_IP:8000 (e.g., http://192.168.1.100:8000)
EXPO_PUBLIC_FISH_API_URL=http://localhost:8000

